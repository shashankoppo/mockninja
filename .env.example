# MOCK NINJA — environment variables (names only, never real values).
# Copy this file to .env and fill in real values.

# ── Frontend (Vite build-time, safe to expose to browser) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Docker / deployment ──
# Port the container exposes (default 8080)
PORT=8080

# ── Supabase (server-side, used by edge functions — NEVER expose to browser) ──
# These are set in the Supabase dashboard, not in the frontend .env.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# ── AI / LLM (set as Supabase edge function secrets) ──
# Already configured for question generation. Add more for future AI features.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Payments (set as Supabase edge function secrets) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Email / SMTP (configured in Supabase dashboard → Auth → Email Settings) ──
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
